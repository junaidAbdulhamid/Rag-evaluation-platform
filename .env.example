# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for Phase 1.

# --- Generation (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
GENERATION_MODEL=claude-opus-5
GENERATION_MAX_TOKENS=1024

# --- Embeddings (local, downloaded on first run; no key needed) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval / chunking defaults (Phase 7 overrides these per experiment) ---
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Data ---
DOCUMENTS_DIR=data/documents
EVAL_DATASET_PATH=data/eval_dataset.json
